# Copy to `.env` and fill in. `.env` is git-ignored.
# Used by generation/openai_generations.py and the LLM-based analysis scripts.

# Azure OpenAI (GPT-5-Pro generation; GPT-4o decomposition/entailment judge)
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_gpt5_DEPLOYMENT=your-gpt5-pro-deployment-name

# Azure Foundry Claude endpoint (optional; only if generating with Claude)
AZURE_CLAUDE_BASE_URL=https://<your-resource-name>.services.ai.azure.com/anthropic/
AZURE_CLAUDE_API_KEY=your-azure-claude-api-key

# AWS HealthScribe (audio-to-note pipeline)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
